{
  "description": "Milestone 1.3 exit check: a 100 x 60 x 40 mm box, its four vertical edges filleted r=5, the top face pulled up 10 mm and the body shelled 2 mm open at the top.",
  "commands": [
    { "command": "solid.box", "params": { "origin": [0, 0, 0], "size": [100, 60, 40] } },
    {
      "command": "edge.fillet",
      "params": {
        "edges": ["F1:+X|F1:+Y", "F1:+X|F1:-Y", "F1:-X|F1:+Y", "F1:-X|F1:-Y"],
        "radius": 5
      }
    },
    { "command": "face.push_pull", "params": { "faces": ["F1:+Z"], "distance": 10 } },
    { "command": "body.shell", "params": { "faces": ["F1:+Z"], "thickness": 2 } },
    { "command": "body.measure", "params": {} }
  ]
}
